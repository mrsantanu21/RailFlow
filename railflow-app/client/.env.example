# RailFlow Frontend Environment Variables

# In development: Leave unset or empty to use Vite's built-in /api proxy (target: http://localhost:3001)
# In production on Cloudflare Pages:
# Option 1 (Direct CORS): Set to your Render backend API base URL:
# VITE_API_BASE_URL="https://railflow-server.onrender.com/api"
#
# Option 2 (Cloudflare Edge Proxy): Leave unset and set BACKEND_API_URL in Cloudflare Pages Dashboard
VITE_API_BASE_URL=""
