# Server Environment Variables
PORT=3001
NODE_ENV=development
# Database Configuration
# Local SQLite (Default for local dev & vitest tests):
DATABASE_URL="file:./dev.db"
# Cloud Persistence (Optional Turso libSQL for production deployment on Render):
# TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-jwt-auth-token-placeholder"

SESSION_SECRET="your-session-secret-change-in-production"
CLIENT_URL="http://localhost:5173"

# Live Train Tracking Providers (Optional)
# 1. ChukChuk API (Open-source FastAPI wrapper for Indian Railways NTES)
# Run locally with: cd chukchuk-api && uv run uvicorn app.main:app --port 8000
CHUKCHUK_API_BASE_URL="http://127.0.0.1:8000"

# 2. RapidAPI Commercial Gateway (Alternative)
# RAPIDAPI_KEY="your-rapidapi-key"
# RAPIDAPI_HOST="indian-railway-irctc.p.rapidapi.com"

# 3. RailRadar Official REST Gateway (Free Tier: 1,000 req/month, 10 req/min)
# Documentation: https://railradar.in/docs/live-train-status
RAILRADAR_API_KEY=""
RAILRADAR_API_BASE_URL="https://api.railradar.in"
RAILRADAR_ENABLED="false"

# Google Gemini AI Journey Assistant (Google AI Studio Free Tier)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"

# DataMeet Indian Railways static JSON catalog (NOT a live API, NOT IRCTC)
# Source: https://github.com/datameet/railways  License: CC0
# Files: stations.json (~2MB), trains.json (~15MB), schedules.json (~82MB)
# No API key is required. RAILWAY_API_KEY is reserved and unused by GitHub raw files.
RAILWAY_API_BASE_URL="https://raw.githubusercontent.com/datameet/railways/master"
RAILWAY_API_KEY=""
DATAMEET_ENABLED="true"
DATAMEET_CACHE_DIR="./data/datameet"
DATAMEET_CACHE_TTL_HOURS="168"
DATAMEET_REQUEST_TIMEOUT_MS="120000"
DATAMEET_MAX_RETRIES="2"
